APP_SECRET=replace-with-a-long-random-value
ADMIN_PASSWORD=replace-with-a-strong-password
DB_PATH=/data/quiz.db
ENABLE_TEST_IDENTITY=false
SEED_DEMO_DATA=false
MIGRATION_HASH_SECRET=replace-with-a-separate-random-value
SUBSCRIBER_SYNC_API_KEY=replace-with-a-separate-long-random-value
SUBSCRIPTION_REGISTRATION_API_KEY=replace-with-another-long-random-secret
SUBSCRIPTION_REGISTRATION_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
SESSION_COOKIE_SECURE=true
SUBSCRIBER_SESSION_DAYS=180
PUBLIC_BASE_URL=https://your-app.up.railway.app
BREVO_API_KEY=replace-with-brevo-api-key
MAGIC_LINK_SENDER_EMAIL=verified-sender@example.com
MAGIC_LINK_SENDER_NAME=반려견영양연구소
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_REQUEST_COOLDOWN_SECONDS=60
BREVO_TIMEOUT_SECONDS=10
COMMUNITY_ADMIN_NOTIFICATION_EMAIL=admin@example.com
